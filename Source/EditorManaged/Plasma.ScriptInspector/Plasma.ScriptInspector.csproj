<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Plasma.ScriptInspector</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=false: the tool is published into CSharp/Tools and resolves ScriptCore from the
         payload root one level up. Copying it here as well produced a second file that silently went
         stale, and the tool then failed to load types the game assembly was built against. -->
    <ProjectReference Include="../../CSharpPlugin/Managed/Plasma.ScriptCore/Plasma.ScriptCore.csproj"
                      Private="false" />
  </ItemGroup>
</Project>
