<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <StartupObject>Plasma.ScriptCompiler.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis"><HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll</HintPath></Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp"><HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll</HintPath></Reference>
    <ProjectReference Include="../../CSharpPlugin/Managed/Plasma.ScriptCore/Plasma.ScriptCore.csproj" />
    <Compile Include="../Plasma.ScriptInspector/Program.cs" Link="Inspection.cs" />
    <Compile Include="../Plasma.ScriptInspector/TestRunner.cs" Link="InspectionTests.cs" />
  </ItemGroup>
</Project>
